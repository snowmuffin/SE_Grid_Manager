  <PropertyGroup>
    <ClientModRoot>$(MSBuildThisFileDirectory)..\</ClientModRoot>
  </PropertyGroup>
  <!-- Do not copy the DLL to the mod root by default: vanilla SE compiles Data/Scripts for session; a loose mod DLL is often not loaded, so the shipped mod uses scripts only. Set CopySeClientDllToModRoot=true to copy (e.g. PluginLoader experiments). -->
  <Target Name="CopyModDll" AfterTargets="Build" Condition="'$(CopySeClientDllToModRoot)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ClientModRoot)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ClientModRoot)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>
